name			rchromium
version			@VERSION@
architecture	x86_64
summary			"Chromium running natively on Haiku x86_64"
description		"R Chromium is Chromium 154 built for Haiku/x86_64 with a BeAPI toolbar \
(back, forward, reload, address field, bookmarks) and bundled Noto Sans CJK fonts. \
Pages are rendered in software and there is no sandbox: Haiku has no seccomp, \
no user namespaces and no zygote."
vendor			"Haiku Project"
packager		"The RENKU project"
copyrights		{
	"2026 The Chromium Authors"
}
licenses		{
	"BSD (3-clause)"
}
provides {
	rchromium = @VERSION@
	app:R_Chromium = @VERSION@
	cmd:rchromium = @VERSION@
}
requires {
	haiku
	lib:libgcc_s
	lib:libstdc++
	lib:libz
}
